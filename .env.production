# Üretim derlemesi ayarları.
#
# Bu dosyada GİZLİ BİLGİ YOKTUR ve bilerek depoya dahil edilir.
# (Uygulamanın hiçbir API anahtarı, sunucu adresi veya hesabı yok.)

# CRA varsayılan olarak küçük bir "runtime" betiğini index.html içine satır içi
# gömer. Satır içi betik, Content-Security-Policy'de 'unsafe-inline' izni
# gerektirir. Bunu kapatarak CSP'yi "script-src 'self'" kadar sıkı tutabiliyoruz.
INLINE_RUNTIME_CHUNK=false

# Kaynak haritalarını üretme: hem paket boyutu küçülür hem de kaynak kodun
# tamamı sunucuya kopyalanmamış olur.
GENERATE_SOURCEMAP=false

# --------------------------------------------------------------------------
# Content-Security-Policy
# --------------------------------------------------------------------------
# index.html içindeki <meta http-equiv="Content-Security-Policy"> etiketine
# gömülür. Bu, GitHub Pages gibi ÖZEL HTTP BAŞLIĞI EKLENEMEYEN barındırma
# hizmetlerinde de korumanın çalışmasını sağlar.
#
# Not: "frame-ancestors" ve "X-Frame-Options" yalnızca HTTP başlığı olarak
# çalışır, meta etiketinde yok sayılır. Clickjacking'e karşı bunun yerine
# src/index.js içindeki çerçeve denetimi devreye giriyor.
REACT_APP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
