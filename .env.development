# Geliştirme sunucusu ayarları (npm start).
#
# Üretimdekiyle aynı CSP burada kullanılamaz: webpack'in sıcak yenileme (HMR)
# mekanizması satır içi betik, eval ve WebSocket bağlantısı kullanır.
# Bu yüzden geliştirmede gevşetilmiş, üretimde sıkı bir politika var.
REACT_APP_CSP=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'
