# ---------------------------------------------------------------
# Firebase Web SDK yapılandırması
# ---------------------------------------------------------------
# 1. https://console.firebase.google.com adresinden projeni aç
# 2. Proje Ayarları > Genel > "Uygulamalarınız" > Web uygulaması
# 3. firebaseConfig değerlerini aşağıya yapıştır
# 4. Bu dosyayı ".env" adıyla kopyala:  cp .env.example .env
#
# NOT: Bu anahtarlar GİZLİ DEĞİLDİR. Firebase Web API anahtarı
# tarayıcıya zaten gönderilir. Gerçek güvenlik firestore.rules ve
# storage.rules dosyalarındadır. Yine de .env'i commit ETME.
# ---------------------------------------------------------------

REACT_APP_FIREBASE_API_KEY=buraya_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=projen.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=projen
REACT_APP_FIREBASE_STORAGE_BUCKET=projen.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ---------------------------------------------------------------
# Maliyet kontrolü (ÜCRETSİZ kullanım için)
# ---------------------------------------------------------------
# Firebase Storage yeni projelerde Blaze (kredi kartı) planı ister.
# Spark (ücretsiz) planda kalmak istiyorsan bunu "false" yap:
# dosya ekleme özelliği tamamen kapanır, uygulama sorunsuz çalışır.
REACT_APP_ENABLE_ATTACHMENTS=true

# Tek dosya için üst sınır (MB). Kotanı korur.
REACT_APP_MAX_FILE_MB=5

# Bir günlüğe eklenebilecek maksimum dosya sayısı.
REACT_APP_MAX_FILES=5
